# ==========================================
# MODULE 4: XGBOOST CROSS-SECTIONAL RANKING MODEL (CLEAN FIXED VERSION)
# ==========================================

import pandas as pd
import numpy as np

from xgboost import XGBRegressor
from sklearn.preprocessing import StandardScaler
from scipy.stats import spearmanr

# ==========================================
# CONFIG
# ==========================================

FEATURES = [
    "Close","Open","High","Low",
    "ma_5","ma_10","ma_21",
    "ema_5","ema_10","ema_21",
    "momentum_5","momentum_10","momentum_21",
    "rsi_14","macd","macd_signal"
]

TARGET = "future_return_5d"   # 🔥 FIXED (was 1D noise)

TOP_K = 0.10                  # top 10% of stocks
TRANSACTION_COST = 0.0005
VOL_TARGET = 0.01

# ==========================================
# LOAD DATA
# ==========================================

def load_data(path):
    df = pd.read_csv(path)
    df.columns = df.columns.str.strip()

    df["Date"] = pd.to_datetime(df["Date"])
    df = df.sort_values(["Date", "Ticker"])

    return df

# ==========================================
# CLEAN
# ==========================================

def clean(df):
    df = df.replace([np.inf, -np.inf], np.nan)
    df = df.dropna(subset=FEATURES + [TARGET])
    return df

# ==========================================
# WALK-FORWARD SPLIT (NO LEAKAGE)
# ==========================================

def walk_forward(df, train_days=504, test_days=21):

    dates = sorted(df["Date"].unique())
    splits = []

    for i in range(train_days, len(dates) - test_days, test_days):

        train_dates = dates[i-train_days:i]
        test_dates = dates[i:i+test_days]

        train = df[df["Date"].isin(train_dates)]
        test = df[df["Date"].isin(test_dates)]

        splits.append((train, test))

    return splits

# ==========================================
# MODEL
# ==========================================

def train_model(X, y):

    model = XGBRegressor(
        n_estimators=300,
        max_depth=4,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        objective="reg:squarederror",
        random_state=42
    )

    model.fit(X, y)
    return model

# ==========================================
# CROSS-SECTION NORMALIZATION (CRITICAL FIX)
# ==========================================

def normalize_by_date(df, col):

    return df.groupby("Date")[col].transform(
        lambda x: (x - x.mean()) / (x.std() + 1e-9)
    )

# ==========================================
# IC CALCULATION (FIXED + STABLE)
# ==========================================

def compute_ic(df):

    ic_values = []

    for date, g in df.groupby("Date"):

        if len(g) < 5:
            continue

        ic = spearmanr(g["pred"], g[TARGET]).correlation
        ic_values.append(ic)

    return np.nanmean(ic_values)

# ==========================================
# BACKTEST (RANK-BASED PORTFOLIO)
# ==========================================

def backtest(df):

    df = df.copy()

    # -----------------------------
    # RANK SIGNAL
    # -----------------------------
    df["rank"] = df.groupby("Date")["pred"].rank(pct=True)

    df["position"] = 0
    df.loc[df["rank"] >= (1 - TOP_K), "position"] = 1

    # -----------------------------
    # VOL SCALING
    # -----------------------------
    df["vol"] = df.groupby("Ticker")[TARGET].transform(lambda x: x.rolling(21).std())
    df["vol"] = df["vol"].fillna(df["vol"].mean())

    df["position_size"] = VOL_TARGET / (df["vol"] + 1e-9)
    df["position_size"] = df["position_size"].clip(0, 2)

    # -----------------------------
    # RETURNS
    # -----------------------------
    df["strategy_return"] = (
        df["position"] *
        df["position_size"] *
        df[TARGET]
    )

    # transaction cost
    df["trade"] = df.groupby("Ticker")["position"].diff().abs().fillna(0)
    df["strategy_return"] -= df["trade"] * TRANSACTION_COST

    # -----------------------------
    # METRICS
    # -----------------------------
    sharpe = (
        df["strategy_return"].mean() /
        (df["strategy_return"].std() + 1e-9)
    ) * np.sqrt(252)

    total_return = (1 + df["strategy_return"].fillna(0)).prod() - 1
    market_return = (1 + df[TARGET].fillna(0)).prod() - 1

    ic = compute_ic(df)

    print("\n📊 XGBOOST RANKING MODEL RESULTS (FIXED)")
    print(f"IC (Spearman): {ic:.4f}")
    print(f"Sharpe: {sharpe:.4f}")
    print(f"Total Return: {total_return:.4f}")

    return df, ic, sharpe, total_return

# ==========================================
# PIPELINE
# ==========================================

def main():

    df = load_data("data/processed/features_dataset.csv")
    df = clean(df)

    splits = walk_forward(df)

    all_results = []

    for i, (train, test) in enumerate(splits):

        # -----------------------------
        # SPLIT FEATURES
        # -----------------------------
        X_train = train[FEATURES]
        y_train = train[TARGET]

        X_test = test[FEATURES].copy()

        # -----------------------------
        # SCALING (FIT ONLY ON TRAIN)
        # -----------------------------
        scaler = StandardScaler()
        X_train_scaled = scaler.fit_transform(X_train)
        X_test_scaled = scaler.transform(X_test)

        # -----------------------------
        # TRAIN MODEL
        # -----------------------------
        model = train_model(X_train_scaled, y_train)

        # -----------------------------
        # PREDICT
        # -----------------------------
        test = test.copy()
        test["pred"] = model.predict(X_test_scaled)

        # CROSS-SECTION NORMALIZATION
        test["pred"] = normalize_by_date(test, "pred")

        # -----------------------------
        # BACKTEST
        # -----------------------------
        result, ic, sharpe, ret = backtest(test)

        all_results.append(result)

        print(f"\n🔁 SPLIT {i+1}")
        print(f"IC: {ic:.4f} | Sharpe: {sharpe:.4f}")

    final = pd.concat(all_results)

    # FINAL STABILITY METRIC
    final_ic = compute_ic(final)

    print("\n📊 FINAL PERFORMANCE (CLEAN MODEL)")
    print(f"Avg IC: {final_ic:.4f}")

    return final

# ==========================================
# RUN
# ==========================================

if __name__ == "__main__":
    main()