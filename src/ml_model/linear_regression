# ==========================================
# MODULE 4: MODELING & PREDICTION
# ==========================================

import pandas as pd
import numpy as np

from sklearn.linear_model import Ridge
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

# -------------------------------
# 1️⃣ CONFIG
# -------------------------------

TARGET_COL = "return_1d"

FEATURE_COLS = [
    "Close","Open","High","Low",
    "ma_5","ma_10","ma_21",
    "ema_5","ema_10","ema_21","ema_12","ema_26",
    "price_ma5_ratio","price_ma10_ratio","price_ma21_ratio",
    "momentum_5","momentum_10","momentum_21",
    "momentum_5_pct","momentum_10_pct","momentum_21_pct",
    "vol_5","vol_10","vol_21","range_pct",
    "volume_avg_5","volume_avg_10","volume_avg_21",
    "volume_momentum_5","volume_price_ratio",
    "rsi_14","macd","macd_signal",
    "risk_adjusted_return",
    "52w_position"
]

# -------------------------------
# 2️⃣ LOAD
# -------------------------------

def load_data(path):
    df = pd.read_csv(path, low_memory=False)
    df.columns = df.columns.str.strip()
    df["Date"] = pd.to_datetime(df["Date"])
    df = df.sort_values(["Ticker", "Date"])
    return df

# -------------------------------
# 3️⃣ PREP
# -------------------------------

def prepare_data(df):
    df = df.dropna(subset=[TARGET_COL])

    split_date = df["Date"].quantile(0.8)

    train_df = df[df["Date"] <= split_date]
    test_df  = df[df["Date"] > split_date]

    X_train = train_df[FEATURE_COLS]
    y_train = train_df[TARGET_COL]

    X_test = test_df[FEATURE_COLS]
    y_test = test_df[TARGET_COL]

    return X_train, X_test, y_train, y_test, test_df

# -------------------------------
# 4️⃣ TRAIN (WITH SCALING + RIDGE)
# -------------------------------

def train_model(X_train, y_train):
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)

    model = Ridge(alpha=1.0)
    model.fit(X_train_scaled, y_train)

    return model, scaler

# -------------------------------
# 5️⃣ EVALUATE
# -------------------------------

def evaluate_model(model, scaler, X_test, y_test):
    X_test_scaled = scaler.transform(X_test)
    y_pred = model.predict(X_test_scaled)

    rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    mae  = mean_absolute_error(y_test, y_pred)
    r2   = r2_score(y_test, y_pred)

    print("\n📊 MODEL PERFORMANCE")
    print(f"RMSE: {rmse:.6f}")
    print(f"MAE : {mae:.6f}")
    print(f"R²  : {r2:.4f}")

    return y_pred

# -------------------------------
# 6️⃣ FEATURE IMPORTANCE
# -------------------------------

def feature_importance(model):
    coef_df = pd.DataFrame({
        "Feature": FEATURE_COLS,
        "Coefficient": model.coef_
    }).sort_values(by="Coefficient", ascending=False)

    print("\n📈 TOP FEATURES")
    print(coef_df.head(10))

# -------------------------------
# 7️⃣ THRESHOLD OPTIMIZATION
# -------------------------------

def optimize_threshold(y_pred, y_true):
    thresholds = np.linspace(0, 0.01, 20)

    best_sharpe = -np.inf
    best_thresh = 0

    for t in thresholds:
        signal = (y_pred > t).astype(int)
        strat_ret = signal * y_true

        if strat_ret.std() == 0:
            continue

        sharpe = (strat_ret.mean() / strat_ret.std()) * np.sqrt(252)

        if sharpe > best_sharpe:
            best_sharpe = sharpe
            best_thresh = t

    print(f"\n🔥 Optimal Threshold: {best_thresh:.5f}")
    print(f"🔥 Best Sharpe: {best_sharpe:.2f}")

    return best_thresh

# -------------------------------
# 8️⃣ BACKTEST (FULL METRICS)
# -------------------------------

def backtest(test_df, y_pred, threshold):
    df = test_df.copy().reset_index(drop=True)

    df["Predicted_Return"] = y_pred
    df["Signal"] = (df["Predicted_Return"] > threshold).astype(int)

    df["Strategy_Return"] = df["Signal"] * df[TARGET_COL]

    df["Cumulative_Market"] = (1 + df[TARGET_COL]).cumprod()
    df["Cumulative_Strategy"] = (1 + df["Strategy_Return"]).cumprod()

    # Drawdown
    df["Rolling_Max"] = df["Cumulative_Strategy"].cummax()
    df["Drawdown"] = (df["Cumulative_Strategy"] - df["Rolling_Max"]) / df["Rolling_Max"]

    df["Volatility_21"] = df["Strategy_Return"].rolling(21).std()

    df["Sharpe_21"] = (
        df["Strategy_Return"].rolling(21).mean() /
        df["Strategy_Return"].rolling(21).std()
    ) * np.sqrt(252)

    # Trade stats
    df["Win"] = (df["Strategy_Return"] > 0).astype(int)
    df["Trade"] = df["Signal"]

    # Summary
    total_return = df["Cumulative_Strategy"].iloc[-1] - 1
    market_return = df["Cumulative_Market"].iloc[-1] - 1

    trades = df["Trade"].sum()
    win_rate = df["Win"].sum() / trades if trades > 0 else 0

    sharpe = (
        df["Strategy_Return"].mean() /
        df["Strategy_Return"].std()
    ) * np.sqrt(252)

    max_dd = df["Drawdown"].min()

    print("\n📊 STRATEGY PERFORMANCE")
    print(f"Strategy Return: {total_return:.2%}")
    print(f"Market Return:   {market_return:.2%}")
    print(f"Trades:          {int(trades)}")
    print(f"Win Rate:        {win_rate:.2%}")
    print(f"Sharpe:          {sharpe:.2f}")
    print(f"Max Drawdown:    {max_dd:.2%}")

    return df

# -------------------------------
# 9️⃣ SAVE
# -------------------------------

def save_results(df):
    final_df = df[[
        "Ticker","Date","return_1d",
        "Predicted_Return","Signal","Strategy_Return",
        "Cumulative_Market","Cumulative_Strategy",
        "Drawdown","Sharpe_21","Volatility_21"
    ]]

    final_df.to_csv("data/processed/linear_model_predictions.csv", index=False)
    print("\n✅ Saved results")

# -------------------------------
# 🔟 MAIN
# -------------------------------

def main():
    df = load_data("data/processed/features_dataset.csv")

    X_train, X_test, y_train, y_test, test_df = prepare_data(df)

    model, scaler = train_model(X_train, y_train)

    y_pred = evaluate_model(model, scaler, X_test, y_test)

    feature_importance(model)

    threshold = optimize_threshold(y_pred, y_test)

    results = backtest(test_df, y_pred, threshold)

    save_results(results)

    print("\n🚀 DONE (FULL OPTIMAL PIPELINE)")

# -------------------------------
# RUN
# -------------------------------

if __name__ == "__main__":
    main()