import pandas as pd
import os
import numpy as np

# ==========================================
# 1. LOAD DATA
# ==========================================
def load_master_dataset(path="data/processed/master_dataset.csv"):
    if not os.path.exists(path):
        raise FileNotFoundError(f"Missing file: {path}")

    df = pd.read_csv(path, low_memory=False)
    df["Date"] = pd.to_datetime(df["Date"])

    df = df.sort_values(["Ticker", "Date"]).reset_index(drop=True)

    print(f"Loaded dataset: {df.shape}")
    return df


# ==========================================
# 2. BASIC CLEANING (BEFORE FEATURES)
# ==========================================
def fill_missing_values(df):

    df = df.replace([np.inf, -np.inf], np.nan)

    zero_cols = [
        'Salaries And Wages',
        'Loss Adjustment Expense',
        'Policyholder Benefits Gross'
    ]

    for col in zero_cols:
        if col in df.columns:
            df[col] = df[col].fillna(0)

    median_cols = [
        'debtToEquity',
        'grossProfit',
        'operatingIncome'
    ]

    for col in median_cols:
        if col in df.columns:
            df[col] = df[col].fillna(df[col].median())

    return df


# ==========================================
# 3. FEATURES (NO TARGET HERE)
# ==========================================
def compute_returns(df):
    df["return_1d"] = df.groupby("Ticker")["Close"].pct_change()
    return df


def compute_moving_averages(df):
    for w in [5, 10, 21]:
        df[f"ma_{w}"] = df.groupby("Ticker")["Close"].transform(
            lambda x: x.rolling(w).mean()
        )
        df[f"price_ma{w}_ratio"] = df["Close"] / (df[f"ma_{w}"] + 1e-9)
    return df


def compute_volatility(df):
    for w in [5, 10, 21]:
        df[f"vol_{w}"] = df.groupby("Ticker")["return_1d"].transform(
            lambda x: x.rolling(w).std()
        )
    return df


def compute_price_range(df):
    df["daily_range"] = df["High"] - df["Low"]
    df["range_pct"] = df["daily_range"] / (df["Close"] + 1e-9)
    return df


def compute_momentum(df):
    for w in [5, 10, 21]:
        df[f"momentum_{w}_pct"] = df.groupby("Ticker")["Close"].transform(
            lambda x: x.pct_change(w)
        )

    df["gap"] = (
        df["Open"] - df.groupby("Ticker")["Close"].shift(1)
    ) / (df.groupby("Ticker")["Close"].shift(1) + 1e-9)

    return df


def compute_volume_features(df):
    for w in [5, 10, 21]:
        df[f"volume_avg_{w}"] = df.groupby("Ticker")["Volume"].transform(
            lambda x: x.rolling(w).mean()
        )
    return df


def compute_technical_indicators(df):
    for span in [5, 10, 21, 12, 26]:
        df[f"ema_{span}"] = df.groupby("Ticker")["Close"].transform(
            lambda x: x.ewm(span=span, adjust=False).mean()
        )

    df["macd"] = df["ema_12"] - df["ema_26"]
    return df


# ==========================================
# 4. TARGET (CRITICAL — DO LAST)
# ==========================================
def compute_targets(df):

    df["future_return_5d"] = (
        df.groupby("Ticker")["Close"].shift(-5) / df["Close"] - 1
    )

    return df


# ==========================================
# 5. SHIFT (LEAKAGE SAFE)
# ==========================================
def shift_features(df):

    # shift ONLY price-based features
    cols_to_shift = [
        "Open", "High", "Low", "Close", "Volume"
    ]

    df[cols_to_shift] = df.groupby("Ticker")[cols_to_shift].shift(1)

    return df


# ==========================================
# 6. CLEAN (SAFE, NOT DESTRUCTIVE)
# ==========================================
def clean(df):

    # remove rows without target
    df = df.dropna(subset=["future_return_5d"])

    # allow partial missing features (VERY IMPORTANT)
    df = df.dropna(thresh=int(df.shape[1] * 0.65))

    return df


# ==========================================
# 7. SAVE
# ==========================================
def save_features(df, path="data/processed/features_dataset.csv"):

    os.makedirs(os.path.dirname(path), exist_ok=True)

    print(f"Final dataset shape: {df.shape}")
    print(f"Target coverage: {df['future_return_5d'].notna().mean():.2%}")

    df.to_csv(path, index=False)


# ==========================================
# MAIN PIPELINE
# ==========================================
def main():

    df = load_master_dataset()

    df = fill_missing_values(df)

    # features
    df = compute_returns(df)
    df = compute_moving_averages(df)
    df = compute_volatility(df)
    df = compute_price_range(df)
    df = compute_momentum(df)
    df = compute_volume_features(df)
    df = compute_technical_indicators(df)

    # SHIFT BEFORE TARGET (CRITICAL FIX)
    df = shift_features(df)

    # TARGET LAST
    df = compute_targets(df)

    # CLEAN LAST
    df = clean(df)
     # 🔍 DEBUG CHECKS (PUT HERE)
    print("\n🔎 DEBUG: TARGET CHECK")
    print("NaN future_return_5d:", df["future_return_5d"].isna().sum())

    print("\n🔎 DEBUG: TICKER DISTRIBUTION")
    print(df.groupby("Ticker").size().describe())

    save_features(df)


if __name__ == "__main__":
    main()