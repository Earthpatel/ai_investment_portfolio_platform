# ==========================================
# MODULE 4: STATEFUL ML TRADING SYSTEM (NO LEAKAGE)
# ==========================================

import pandas as pd
import numpy as np

from sklearn.linear_model import Ridge
from sklearn.preprocessing import StandardScaler
from scipy.stats import spearmanr

# ==========================================
# 1️⃣ CONFIG
# ==========================================

TARGET_COL = "return_1d"

FEATURE_COLS = [
    "Close","Open","High","Low",
    "ma_5","ma_10","ma_21",
    "ema_5","ema_10","ema_21",
    "momentum_5","momentum_10","momentum_21",
    "rsi_14","macd","macd_signal"
]

TRANSACTION_COST = 0.0005
VOL_TARGET = 0.01

# ==========================================
# 2️⃣ LOAD DATA
# ==========================================

def load_data(path):
    df = pd.read_csv(path)
    df.columns = df.columns.str.strip()

    df["Date"] = pd.to_datetime(df["Date"], utc=True)
    df["Date"] = df["Date"].dt.tz_convert(None)

    df = df.sort_values(["Ticker", "Date"])
    return df

# ==========================================
# 3️⃣ CLEAN + FIX LEAKAGE
# ==========================================

def clean_data(df):

    df = df.replace([np.inf, -np.inf], np.nan)

    # --------------------------------------
    # 🚨 CRITICAL: SHIFT FEATURES BACK 1 DAY
    # --------------------------------------
    df[FEATURE_COLS] = df.groupby("Ticker")[FEATURE_COLS].shift(1)

    df = df.dropna(subset=FEATURE_COLS + [TARGET_COL])

    return df

# ==========================================
# 4️⃣ WALK FORWARD SPLITS
# ==========================================

def walk_forward_splits(df, train_size=252*2, test_size=21):

    dates = df["Date"].unique()
    splits = []

    for i in range(train_size, len(dates) - test_size, test_size):

        train_dates = dates[i-train_size:i]
        test_dates = dates[i:i+test_size]

        train = df[df["Date"].isin(train_dates)]
        test = df[df["Date"].isin(test_dates)]

        if len(train) == 0 or len(test) == 0:
            continue

        splits.append((train, test))

    return splits

# ==========================================
# 5️⃣ TRAIN MODEL
# ==========================================

def train_model(X, y):
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    model = Ridge(alpha=1.0)
    model.fit(X_scaled, y)

    return model, scaler

# ==========================================
# 6️⃣ GENERATE POSITIONS (LONG / SHORT / FLAT)
# ==========================================

def generate_positions(preds):

    long_threshold = np.quantile(preds, 0.8)
    short_threshold = np.quantile(preds, 0.2)

    positions = []

    for p in preds:
        if p > long_threshold:
            positions.append(1)
        elif p < short_threshold:
            positions.append(-1)
        else:
            positions.append(0)

    return np.array(positions)

# ==========================================
# 7️⃣ BACKTEST
# ==========================================

def backtest(df, preds):

    df = df.copy()
    df["Predicted"] = preds

    # -------------------------
    # SIGNAL
    # -------------------------
    df["Position"] = generate_positions(preds)

    # -------------------------
    # VOLATILITY SCALING
    # -------------------------
    df["volatility"] = df.groupby("Ticker")[TARGET_COL].transform(
        lambda x: x.rolling(21).std()
    )

    df["volatility"] = df["volatility"].replace(0, np.nan)

    df["position_size"] = (VOL_TARGET / df["volatility"]).clip(0, 2)
    df["position_size"] = df["position_size"].fillna(0)

    # -------------------------
    # RETURNS
    # -------------------------
    df["Strategy_Return"] = (
        df["Position"] *
        df["position_size"] *
        df[TARGET_COL]
    )

    # transaction costs
    df["Trade"] = df.groupby("Ticker")["Position"].diff().abs().fillna(0)
    df["Strategy_Return"] -= df["Trade"] * TRANSACTION_COST

    # -------------------------
    # CUMULATIVE RETURNS
    # -------------------------
    df["Cumulative_Strategy"] = df.groupby("Ticker")["Strategy_Return"].apply(
        lambda x: (1 + x.fillna(0)).cumprod()
    ).reset_index(level=0, drop=True)

    df["Cumulative_Market"] = df.groupby("Ticker")[TARGET_COL].apply(
        lambda x: (1 + x.fillna(0)).cumprod()
    ).reset_index(level=0, drop=True)

    # -------------------------
    # DRAWDOWN
    # -------------------------
    def dd(x):
        peak = x.cummax()
        return (x - peak) / peak

    df["Drawdown"] = df.groupby("Ticker")["Cumulative_Strategy"].apply(dd)\
                       .reset_index(level=0, drop=True)

    # -------------------------
    # METRICS
    # -------------------------
    std = df["Strategy_Return"].std()

    if std < 1e-6:
        sharpe = 0
    else:
        sharpe = (df["Strategy_Return"].mean() / std) * np.sqrt(252)

    total_return = df.groupby("Ticker")["Cumulative_Strategy"].last().mean() - 1
    market_return = df.groupby("Ticker")["Cumulative_Market"].last().mean() - 1

    trades = df["Trade"].sum()
    win_rate = (df["Strategy_Return"] > 0).mean()

    return df, {
        "sharpe": sharpe,
        "total_return": total_return,
        "market_return": market_return,
        "max_drawdown": df["Drawdown"].min(),
        "trades": trades,
        "win_rate": win_rate
    }

# ==========================================
# 8️⃣ MAIN PIPELINE
# ==========================================

def main():

    df = load_data("data/processed/features_dataset.csv")

    # --------------------------------------
    # ✅ ENSURE TARGET IS CORRECTLY DEFINED
    # --------------------------------------
    df[TARGET_COL] = df.groupby("Ticker")["Close"].pct_change().shift(-1)

    df = clean_data(df)

    splits = walk_forward_splits(df)

    all_results = []

    for i, (train, test) in enumerate(splits):

        print(f"\n🔁 SPLIT {i+1}")

        X_train = train[FEATURE_COLS]
        y_train = train[TARGET_COL]

        X_test = test[FEATURE_COLS]
        y_test = test[TARGET_COL]

        model, scaler = train_model(X_train, y_train)

        preds = model.predict(scaler.transform(X_test))

        # -------------------------
        # INFORMATION COEFFICIENT
        # -------------------------
        ic, _ = spearmanr(preds, y_test)
        print(f"IC: {ic:.4f}")

        result_df, metrics = backtest(test, preds)

        print(f"Sharpe: {metrics['sharpe']:.4f} | Return: {metrics['total_return']:.4f}")

        all_results.append(result_df)

    # ==========================================
    # FINAL AGGREGATED RESULTS
    # ==========================================

    final_df = pd.concat(all_results)

    std = final_df["Strategy_Return"].std()
    overall_sharpe = 0 if std < 1e-6 else (
        final_df["Strategy_Return"].mean() / std * np.sqrt(252)
    )

    total_return = final_df.groupby("Ticker")["Cumulative_Strategy"].last().mean() - 1
    market_return = final_df.groupby("Ticker")["Cumulative_Market"].last().mean() - 1

    print("\n📊 FINAL OVERALL PERFORMANCE")
    print(f"Sharpe: {overall_sharpe:.4f}")
    print(f"Total Return: {total_return:.4f}")
    print(f"Market Return: {market_return:.4f}")
    print(f"Max Drawdown: {final_df['Drawdown'].min():.4f}")
    print(f"Win Rate: {(final_df['Strategy_Return'] > 0).mean():.4f}")

    final_df.to_csv("data/processed/final_no_leakage_trading_system.csv", index=False)

    print("\n🚀 DONE: NO-LEAKAGE TRADING SYSTEM COMPLETE")

# ==========================================
# RUN
# ==========================================

if __name__ == "__main__":
    main()