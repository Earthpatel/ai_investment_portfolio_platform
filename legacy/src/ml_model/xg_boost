import pandas as pd
import numpy as np
from scipy.stats import spearmanr
from sklearn.linear_model import Ridge
from sklearn.preprocessing import StandardScaler
import lightgbm as lgb

# ==========================================
# 1. LOAD DATA
# ==========================================
def load_data(path):
    df = pd.read_csv(path, low_memory=False)
    df["Date"] = pd.to_datetime(df["Date"], utc=True, errors="coerce")
    df = df.dropna(subset=["Date"])
    df = df.sort_values(["Date", "Ticker"]).reset_index(drop=True)
    return df


# ==========================================
# 2. FEATURE ENGINEERING HELPERS
# ==========================================
def clean_features(X):
    return (
        X.replace([np.inf, -np.inf], np.nan)
         .fillna(0)
    )

def get_features(df):
    exclude = {"Ticker", "Date", "future_return_5d"}
    features = [c for c in df.columns if c not in exclude]
    return df[features].select_dtypes(include=np.number).columns.tolist()

def cross_sectional_zscore(df, features):
    return df.groupby("Date")[features].transform(
        lambda x: (x - x.mean()) / (x.std() + 1e-9)
    )


# ==========================================
# 3. REGIME DETECTION (VOLATILITY STATE)
# ==========================================
def add_regime(df):
    vol = df.groupby("Date")["future_return_5d"].transform("std")
    df["regime"] = pd.qcut(vol, 3, labels=["low_vol", "mid_vol", "high_vol"])
    return df


# ==========================================
# 4. WALK-FORWARD SPLIT
# ==========================================
def walk_forward_splits(df, n_splits=5):
    dates = np.sort(df["Date"].unique())
    step = len(dates) // n_splits

    splits = []
    for i in range(3, n_splits):
        train_dates = dates[:i * step]
        test_dates = dates[i * step:(i + 1) * step]

        train = df[df["Date"].isin(train_dates)]
        test = df[df["Date"].isin(test_dates)]

        splits.append((train, test))

    return splits


# ==========================================
# 5. IC METRIC
# ==========================================
def compute_ic(df):
    ics = []
    for _, g in df.groupby("Date"):
        if len(g) < 5:
            continue
        if g["pred"].std() == 0:
            continue

        ic = spearmanr(g["pred"], g["future_return_5d"]).correlation
        if np.isfinite(ic):
            ics.append(ic)

    return np.mean(ics) if ics else 0


# ==========================================
# 6. FEATURE IC TRACKING
# ==========================================
def feature_ic(df, features):
    ic_scores = {}

    for f in features:
        ics = []
        for _, g in df.groupby("Date"):
            if g[f].std() == 0:
                continue
            ic = spearmanr(g[f], g["future_return_5d"]).correlation
            if np.isfinite(ic):
                ics.append(ic)

        ic_scores[f] = np.mean(ics) if ics else 0

    return pd.Series(ic_scores).sort_values(ascending=False)


# ==========================================
# 7. MODELS (ENSEMBLE)
# ==========================================
def train_models(X, y):

    X = clean_features(X)
    y = y.fillna(0)

    models = {}

    # LightGBM
    models["lgb"] = lgb.LGBMRegressor(
        n_estimators=500,
        learning_rate=0.03,
        num_leaves=63,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=42
    ).fit(X, y)

    # Linear model (FIXED)
    scaler = StandardScaler()
    Xs = scaler.fit_transform(X)

    models["linear"] = Ridge(alpha=1.0)
    models["linear"].fit(Xs, y)

    models["scaler"] = scaler

    return models


# ==========================================
# 8. ENSEMBLE PREDICTION
# ==========================================
def predict_ensemble(models, X):

    X = clean_features(X)

    lgb_pred = models["lgb"].predict(X)

    Xs = models["scaler"].transform(X)
    lin_pred = models["linear"].predict(Xs)

    return (lgb_pred + lin_pred) / 2

# ==========================================
# 9. VOLATILITY-SCALED PORTFOLIO
# ==========================================
def portfolio(df):
    returns = []

    for _, g in df.groupby("Date"):
        vol = g["future_return_5d"].std() + 1e-9
        weights = g["pred"] / (vol + 1e-9)

        ret = np.sum(weights * g["future_return_5d"])
        returns.append(ret)

    returns = np.array(returns)

    sharpe = returns.mean() / (returns.std() + 1e-9)
    return sharpe, returns.sum()


# ==========================================
# 10. TRAIN + EVALUATE PIPELINE
# ==========================================
def run(df, features):

    splits = walk_forward_splits(df)

    all_preds = []
    all_true = []

    ic_list = []

    for train, test in splits:

        train = train.dropna(subset=["future_return_5d"])
        test = test.dropna(subset=["future_return_5d"])

        # normalize
        train[features] = cross_sectional_zscore(train, features)
        test[features] = cross_sectional_zscore(test, features)

        X_train = train[features]
        y_train = train["future_return_5d"]

        X_test = test[features]

        models = train_models(X_train, y_train)

        test = test.copy()
        test["pred"] = predict_ensemble(models, X_test)

        ic_list.append(compute_ic(test))

        all_preds.append(test)

    full = pd.concat(all_preds)

    # IC per feature
    ic_scores = feature_ic(full, features)

    sharpe, total = portfolio(full)

    print("\n📊 HEDGE FUND ALPHA ENGINE RESULTS")
    print(f"IC: {np.mean(ic_list):.4f}")
    print(f"Sharpe: {sharpe:.4f}")
    print(f"Total Return: {total:.4f}")

    print("\n🔥 TOP FEATURES BY IC")
    print(ic_scores.head(15))

    return full, ic_scores


# ==========================================
# MAIN
# ==========================================
def main():
    df = load_data("data/processed/features_dataset.csv")

    features = get_features(df)

    df = add_regime(df)

    run(df, features)


if __name__ == "__main__":
    main()